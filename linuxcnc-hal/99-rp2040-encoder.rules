# udev rules for the RP2040 LinuxCNC HAL Quadrature Encoder Interface.
#
# Grants the plugdev group read/write access to the device in normal
# operating mode (2e8a:c0de) and in BOOTSEL mass-storage / picotool mode
# (2e8a:0003), so neither the LinuxCNC HAL component nor picotool needs
# to run as root.
#
# Install:
#   sudo cp 99-rp2040-encoder.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   sudo usermod -a -G plugdev "$USER"     # log out / back in to apply
#
# Verify after replug:
#   ls -l /dev/bus/usb/$(lsusb | awk '/2e8a:c0de/ {print $2"/"substr($4,1,3)}')

SUBSYSTEMS=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="c0de", MODE="0666", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0003", MODE="0666", GROUP="plugdev", TAG+="uaccess"
