component rp2040_encoder "RP2040 USB quadrature encoder interface";
author "Claude";
license "GPL";

pin out float position-#[4] "Position values from the RP2040 device";
pin out bit connected "True when USB device is connected";
pin in s32 test-mode "Test mode: 0=off, 1=sine wave, 2=circular, 3=linear ramp, 4=random walk";
pin out float scale-fb-#[4] = -1e30 "Scale factor for each encoder";
pin in float scale-#[4] "Scale factor for each encoder";
pin in u32 reset-#[4] "Reset encoder position to zero (change in value triggered)";
pin in s32 sign-#[4] = 1 "Per-axis sign: +1 normal, -1 inverts the position output";
pin in bit ref-enable-#[4] = 1 "Enable reference (R) pulse recognition on GP26-GP29";
pin in bit ref-invert-#[4] = 0 "Invert reference (R) pulse polarity: 0=active-high/rising, 1=active-low/falling";
pin io bit index-enable-#[4] = 0 "LinuxCNC index-enable handshake: set 1 to arm zero-on-next-R; cleared to 0 on R pulse";
pin out float ref-position-#[4] "Latched encoder position at the most recent reference (R) pulse";
pin out u32 ref-count-#[4] "Count of reference (R) pulses detected";
pin out bit ref-state-#[4] "Live logical state of reference (R) input on GP26-GP29";

option userspace yes;
option extra_link_args "-lusb-1.0";

;;

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <libusb-1.0/libusb.h>
#include <string.h>
#include <errno.h>
#include <signal.h>
#include <math.h>
#include <time.h>

// Protocol constants - source of truth: rp2040-firmware/usb_device.h
#define VENDOR_ID 0x2E8A
#define PRODUCT_ID 0xC0DE
#define EP_IN 0x81
#define EP_OUT 0x01

#define VENDOR_REQUEST_GET_POSITION 0x01
#define VENDOR_REQUEST_SET_TEST_MODE 0x02
#define VENDOR_REQUEST_SET_SCALE 0x03
#define VENDOR_REQUEST_GET_SCALE 0x04
#define VENDOR_REQUEST_RESET_POSITION 0x05
#define VENDOR_REQUEST_GET_VERSION 0x06
#define VENDOR_REQUEST_BOOTSEL 0x07
#define VENDOR_REQUEST_RESET_CONFIG 0x08
#define VENDOR_REQUEST_SET_REF_CONFIG 0x09
#define VENDOR_REQUEST_GET_REF_POSITION 0x0A
#define VENDOR_REQUEST_ARM_INDEX 0x0B

#define POSITION_DATA_SENTINEL 0x3F8A7C91
#define SCALE_DATA_SENTINEL 0x7B2D4E8F
#define VERSION_DATA_SENTINEL 0x5A1B9C3D
#define REF_POSITION_DATA_SENTINEL 0x9C4E2A71

static libusb_device_handle *dev_handle = NULL;
static libusb_context *ctx = NULL;
static volatile sig_atomic_t should_exit = 0;
static int last_test_mode = -1;
static double last_scale[4] = {-1e30, -1e30, -1e30, -1e30};
static double last_scale_fb[4] = {-1e30, -1e30, -1e30, -1e30};
static int last_reset[4] = {0, 0, 0, 0};
static int last_ref_enable_mask = -1;
static int last_ref_invert_mask = -1;
static int last_index_armed[4] = {0, 0, 0, 0};
static uint32_t last_ref_count[4] = {0, 0, 0, 0};
static double invalid_scale_value = -1e30;

static void signal_handler(int /*sig*/) {
    should_exit = 1;
}

static void cleanup_usb(void) {
    if (dev_handle) {
        libusb_release_interface(dev_handle, 0);
        libusb_close(dev_handle);
    }
    
    if (ctx) {
        libusb_exit(ctx);
    }
}

// Reads the response to one request. Firmware up to v3.0.0 answers with one 64-byte packet,
// which is a whole number of USB packets, so TinyUSB ends the transfer with a zero-length
// packet. A read of 64 bytes completes on the data packet and leaves that empty packet at the
// head of the pipe: without skipping it here, every second read returned nothing and the answer
// to one request was taken for the answer to the next (GET_REF_POSITION then never matched its
// sentinel). Later firmware answers with 56 bytes, one short packet and nothing after it; both
// are read here. Frames with another sentinel are answers nobody collected and are skipped as
// well.
static int read_response(uint8_t *buf, int size, uint32_t sentinel, int min_length, int *length) {
    for (int tries = 0; tries < 8; tries++) {
        int n = 0;
        int r = libusb_bulk_transfer(dev_handle, EP_IN, buf, size, &n, 100);
        if (r != 0) {
            return r;
        }
        if (n >= min_length && n >= (int)sizeof(uint32_t)) {
            uint32_t found = 0;
            memcpy(&found, buf, sizeof(found));
            if (found == sentinel) {
                *length = n;
                return 0;
            }
        }
    }
    return LIBUSB_ERROR_OTHER;
}

static int init_usb(void) {
    int r;
    
    // Initialize libusb
    r = libusb_init(&ctx);
    if (r < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR, "rp2040_encoder: Failed to initialize libusb\n");
        return -1;
    }
    
    return 0;
}

void user_mainloop(void) {
    uint8_t buffer[64];
    int actual_length;
    int r;
    static int usb_initialized = 0;
    static int startup_message_shown = 0;
    
    // Show startup message on first call
    if (!startup_message_shown) {
        printf("rp2040_encoder: RP2040 USB Quadrature Encoder Interface starting up\n");
        printf("rp2040_encoder: Looking for device VID:0x%04X PID:0x%04X\n", VENDOR_ID, PRODUCT_ID);
        fflush(stdout);
        startup_message_shown = 1;
    }
    
    // Initialize USB on first call
    if (!usb_initialized) {
        if (init_usb() < 0) {
            return;
        }
        usb_initialized = 1;
        printf("rp2040_encoder: USB subsystem initialized\n");
        fflush(stdout);
        
        // Set up signal handlers for cleanup
        signal(SIGINT, signal_handler);
        signal(SIGTERM, signal_handler);
    }
    
    while (!should_exit) {
        FOR_ALL_INSTS() {
            
            // Try to open device if not connected
            if (!dev_handle) {
                dev_handle = libusb_open_device_with_vid_pid(ctx, VENDOR_ID, PRODUCT_ID);
                if (dev_handle) {
                    // Claim interface
                    r = libusb_claim_interface(dev_handle, 0);
                    if (r < 0) {
                        rtapi_print_msg(RTAPI_MSG_ERR, "rp2040_encoder: Failed to claim interface\n");
                        libusb_close(dev_handle);
                        dev_handle = NULL;
                    } else {
                        printf("rp2040_encoder: Device connected and ready\n");
                        fflush(stdout);

                        // Drain any response left queued in the device IN
                        // endpoint by a previous session. Without this, a stale
                        // frame sits at the head of the stream and every
                        // request/response pair reads one response behind for
                        // the whole session (sentinels prevent misreads but not
                        // the latency). Short timeout; loop until the pipe is
                        // empty or we hit a sane cap.
                        {
                            uint8_t drain_buf[64];
                            int drain_len = 0;
                            for (int drained = 0; drained < 16; drained++) {
                                int dr = libusb_bulk_transfer(dev_handle, EP_IN, drain_buf,
                                                              sizeof(drain_buf), &drain_len, 20);
                                // An empty packet ends a response, not the queue: only a
                                // timeout says the pipe is empty.
                                if (dr != 0) {
                                    break;
                                }
                            }
                        }

                        // Read the firmware version once so the LinuxCNC log
                        // records exactly which build is in the device.
                        uint8_t version_buf[64];
                        version_buf[0] = VENDOR_REQUEST_GET_VERSION;
                        int vlen = 0;
                        int vr = libusb_bulk_transfer(dev_handle, EP_OUT, version_buf, 1, &vlen, 200);
                        if (vr == 0) {
                            // 64 bytes from firmware up to v3.0.0, 56 bytes from later firmware.
                            vr = read_response(version_buf, sizeof(version_buf), VERSION_DATA_SENTINEL, 56, &vlen);
                            if (vr == 0 && vlen >= 56) {
                                uint32_t vsentinel = 0;
                                memcpy(&vsentinel, version_buf, sizeof(vsentinel));
                                if (vsentinel == VERSION_DATA_SENTINEL) {
                                    version_buf[vlen - 1] = '\0';  // belt + suspenders
                                    printf("rp2040_encoder: Firmware version: %s\n",
                                           (const char*)(version_buf + sizeof(vsentinel)));
                                    fflush(stdout);
                                }
                            }
                        }

                        // Reset test mode and reference tracking to force resend
                        last_test_mode = -1;
                        last_ref_enable_mask = -1;
                        last_ref_invert_mask = -1;

                        // Reset scale tracking to trigger initial read. Both
                        // last_scale (host -> device sync) and last_scale_fb
                        // (device -> host feedback) must be invalidated: the
                        // feedback gate at the top of the dev_handle block
                        // checks last_scale_fb, so leaving stale values from
                        // the prior session there means GET_SCALE is never
                        // re-issued after a replug.
                        for (int i = 0; i < 4; i++) {
                            last_scale[i] = invalid_scale_value;
                            last_scale_fb[i] = invalid_scale_value;
                            last_index_armed[i] = 0;
                            last_ref_count[i] = 0;
                        }

                        // Give device time to initialize
                        usleep(2000000); // 2 second delay
                        connected = 1;
                    }
                } else {
                    connected = 0;
                    // Disconnected: back off from the 1 ms outer cadence so
                    // libusb_open_device_with_vid_pid is not walking sysfs
                    // ~1000x/sec while no device is present. 200 ms keeps
                    // replug latency well under what a human notices.
                    usleep(200000);
                }
            }
            
            if (dev_handle) {
                if (scale_fb(0) <= invalid_scale_value || last_scale_fb[0] <= invalid_scale_value) {
                    buffer[0] = VENDOR_REQUEST_GET_SCALE;
                    actual_length = 0;
                    r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 1, &actual_length, 100);
                    if (r == 0) {
                        r = read_response(buffer, sizeof(buffer), SCALE_DATA_SENTINEL, 36, &actual_length);
                        if (r == 0 && actual_length >= 36) {
                            uint32_t sentinel = 0;
                            memcpy(&sentinel, buffer, sizeof(sentinel));
                            if (sentinel == SCALE_DATA_SENTINEL) {
                                double scales_fb[4];
                                memcpy(scales_fb, buffer + 4, sizeof(scales_fb));
                                for (int i = 0; i < 4; i++) {
                                    scale_fb(i) = scales_fb[i];
                                    last_scale_fb[i] = scales_fb[i];
                                }
                            }
                        }
                    }
                } else {
                    if (test_mode != last_test_mode && test_mode >= 0 && test_mode <= 4) {
                        buffer[0] = VENDOR_REQUEST_SET_TEST_MODE;
                        buffer[1] = test_mode;  // 0=off, 1-4=test patterns
                        r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 2, &actual_length, 100);
                        if (r == 0) {
                            last_test_mode = test_mode;
                        }
                    }
                    
                    // Check for scale factor changes
                    for (int i = 0; i < 4; i++) {
                        if (scale(i) > invalid_scale_value && scale(i) != last_scale[i]) {
                            buffer[0] = VENDOR_REQUEST_SET_SCALE;
                            buffer[1] = i;  // Encoder index
                            double scale_value = scale(i);
                            memcpy(&buffer[2], &scale_value, sizeof(double));
                            r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 10, &actual_length, 100);
                            if (r == 0) {
                                last_scale[i] = scale(i);
                            }
                        }
                    }
                    
                    for (int i = 0; i < 4; i++) {
                        if (reset(i) != last_reset[i]) {
                            buffer[0] = VENDOR_REQUEST_RESET_POSITION;
                            buffer[1] = i;  // Encoder index
                            r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 2, &actual_length, 100);
                            // Only latch the new value once the device has
                            // acknowledged it. A transient USB error must NOT
                            // swallow an axis-zero request — leaving last_reset
                            // unchanged makes the next loop iteration retry it.
                            if (r == 0) {
                                last_reset[i] = reset(i);
                            }
                        }
                    }

                    // Sync reference (R) pulse enable/polarity configuration
                    {
                        uint8_t enable_mask = 0;
                        uint8_t invert_mask = 0;
                        for (int i = 0; i < 4; i++) {
                            if (ref_enable(i)) {
                                enable_mask |= (uint8_t)(1U << i);
                            }
                            if (ref_invert(i)) {
                                invert_mask |= (uint8_t)(1U << i);
                            }
                        }
                        if ((int)enable_mask != last_ref_enable_mask ||
                            (int)invert_mask != last_ref_invert_mask) {
                            buffer[0] = VENDOR_REQUEST_SET_REF_CONFIG;
                            buffer[1] = enable_mask;
                            buffer[2] = invert_mask;
                            r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 3, &actual_length, 100);
                            if (r == 0) {
                                last_ref_enable_mask = (int)enable_mask;
                                last_ref_invert_mask = (int)invert_mask;
                            }
                        }
                    }

                    // Sync LinuxCNC index-enable arming/disarming
                    for (int i = 0; i < 4; i++) {
                        int want_arm = (index_enable(i) && ref_enable(i)) ? 1 : 0;
                        if (want_arm != last_index_armed[i]) {
                            buffer[0] = VENDOR_REQUEST_ARM_INDEX;
                            buffer[1] = (uint8_t)i;
                            buffer[2] = (uint8_t)want_arm;
                            r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 3, &actual_length, 100);
                            if (r == 0) {
                                last_index_armed[i] = want_arm;
                            }
                        }
                    }
                    
                    // Send position request
                    buffer[0] = VENDOR_REQUEST_GET_POSITION;
                    r = libusb_bulk_transfer(dev_handle, EP_OUT, buffer, 1, &actual_length, 100);
                    if (r == 0) {
                        // Read position response
                        r = read_response(buffer, 64, POSITION_DATA_SENTINEL, 36, &actual_length);
                        if (r == 0 && actual_length >= 36) {
                            uint32_t sentinel = 0;
                            memcpy(&sentinel, buffer, sizeof(sentinel));
                            if (sentinel == POSITION_DATA_SENTINEL) {
                                double positions[4];
                                memcpy(positions, buffer + 4, sizeof(positions));
                                // Treat any non-negative sign pin as +1; only
                                // an explicit -1 inverts. Guards against a
                                // user accidentally setting sign to 0 and
                                // silently zeroing the axis.
                                for (int i = 0; i < 4; i++) {
                                    position(i) = (sign(i) < 0 ? -1.0 : 1.0) * positions[i];
                                }

                                if (actual_length >= 56) {
                                    uint8_t ref_live_mask = buffer[38];
                                    uint8_t index_armed_mask = buffer[39];
                                    uint32_t ref_counts[4];
                                    memcpy(ref_counts, buffer + 40, sizeof(ref_counts));

                                    int ref_changed = 0;
                                    for (int i = 0; i < 4; i++) {
                                        ref_state(i) = (ref_live_mask >> i) & 1;
                                        ref_count(i) = ref_counts[i];
                                        if (last_index_armed[i] && !((index_armed_mask >> i) & 1)) {
                                            // RP2040 latched R and zeroed position(i) above.
                                            index_enable(i) = 0;
                                            last_index_armed[i] = 0;
                                        }
                                        if (ref_counts[i] != last_ref_count[i]) {
                                            ref_changed = 1;
                                        }
                                    }

                                    // Fetch latched ref positions only when a new R pulse occurred
                                    if (ref_changed) {
                                        uint8_t ref_buf[64];
                                        int ref_len = 0;
                                        ref_buf[0] = VENDOR_REQUEST_GET_REF_POSITION;
                                        int rr = libusb_bulk_transfer(dev_handle, EP_OUT, ref_buf, 1, &ref_len, 100);
                                        if (rr == 0) {
                                            rr = read_response(ref_buf, sizeof(ref_buf), REF_POSITION_DATA_SENTINEL,
                                                               52, &ref_len);
                                            if (rr == 0 && ref_len >= 52) {
                                                uint32_t rsentinel = 0;
                                                memcpy(&rsentinel, ref_buf, sizeof(rsentinel));
                                                if (rsentinel == REF_POSITION_DATA_SENTINEL) {
                                                    double ref_positions[4];
                                                    uint32_t confirmed_counts[4];
                                                    memcpy(ref_positions, ref_buf + 4, sizeof(ref_positions));
                                                    memcpy(confirmed_counts, ref_buf + 36, sizeof(confirmed_counts));
                                                    for (int i = 0; i < 4; i++) {
                                                        ref_position(i) =
                                                            (sign(i) < 0 ? -1.0 : 1.0) * ref_positions[i];
                                                        last_ref_count[i] = confirmed_counts[i];
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        } else if (r == LIBUSB_ERROR_TIMEOUT) {
                            printf("rp2040_encoder: LIBUSB_ERROR_TIMEOUT\n");
                            // A late response would land at the head of the next
                            // bulk-in and desync the stream; reset the EP queue.
                            libusb_clear_halt(dev_handle, EP_IN);
                        } else if (r == LIBUSB_ERROR_NO_DEVICE || r == LIBUSB_ERROR_IO) {
                            printf("rp2040_encoder: LIBUSB_ERROR_NO_DEVICE || LIBUSB_ERROR_IO\n");
                            // Device disconnected
                            libusb_release_interface(dev_handle, 0);
                            libusb_close(dev_handle);
                            dev_handle = NULL;
                            connected = 0;
                        }
                    } else if (r == LIBUSB_ERROR_NO_DEVICE || r == LIBUSB_ERROR_IO) {
                        printf("rp2040_encoder: LIBUSB_ERROR_NO_DEVICE || LIBUSB_ERROR_IO\n");
                        // Device disconnected
                        libusb_release_interface(dev_handle, 0);
                        libusb_close(dev_handle);
                        dev_handle = NULL;
                        connected = 0;
                    }
                }
            }
        }
        
        usleep(1000); // 1000μs sleep
    }
    
    // Clean up on exit
    cleanup_usb();
}
