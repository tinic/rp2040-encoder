# clang-format config for rp2040-encoder. Mirrors ../tvm802-vision/.clang-format
# so dev habits transfer between repos.
#
# Based on Google style, adapted to this codebase's existing conventions:
#   - 4-space indent (not Google's 2)
#   - left-aligned pointers (const void* p)
#   - namespace contents not indented
#   - control-flow bodies always braced as multi-line blocks (see below)
#
# ColumnLimit is 0 on purpose: dense initialization tables and hand-aligned
# trailing comments read better without forced reflow. Set ColumnLimit to e.g.
# 100 if you'd rather have wrapping enforced.
#
# Short if/loop/block bodies are NOT kept on one line: clang-tidy
# (readability-braces-around-statements) requires braces on every body --
# brace-less one-liners are merge-error-prone -- so AllowShort*OnASingleLine are
# off and clang-format expands each body into a uniform `if (c) { ... }` block.
---
Language:        Cpp
Standard:        c++20
BasedOnStyle:    Google
ColumnLimit:     0
IndentWidth:     4
TabWidth:        4
UseTab:          Never
AccessModifierOffset: -4
NamespaceIndentation: None
PointerAlignment: Left
DerivePointerAlignment: false
ReflowComments:  false
SortIncludes:    false
SpacesBeforeTrailingComments: 2
AlignTrailingComments: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
KeepEmptyLinesAtTheStartOfBlocks: false
...
